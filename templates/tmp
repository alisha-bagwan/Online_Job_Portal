<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
</head>
<body class="bg-light">

<nav class="navbar navbar-dark bg-primary">
    <div class="container">

        <span class="navbar-brand">
            Job Portal
        </span>

        <a href="/logout" class="btn btn-light">
            Logout
        </a>
        <a href="/admin" class="btn btn-danger">
      Admin Panel
     </a>

    </div>
</nav>

<div class="container mt-5">

    <div class="row">

        <div class="col-md-4">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h2>{{ total_jobs }}</h2>
                    <h5>Total Jobs</h5>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h2>{{ total_applications }}</h2>
                    <h5>Total Applications</h5>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h2>{{ total_users }}</h2>
                    <h5>Total Users</h5>
                </div>
            </div>
        </div>

    </div>

</div>

<div class="container mt-5">

    <h1 class="text-center mb-5">
        Welcome to Job Portal
    </h1>

    <div class="row">

        <div class="col-md-3 mb-4">

            <div class="card shadow text-center p-4">

                <h4>Jobs</h4>

                <a href="/jobs" class="btn btn-primary mt-3">
                    View Jobs
                </a>

            </div>

        </div>

        <div class="col-md-3 mb-4">

            <div class="card shadow text-center p-4">

                <h4>Add Job</h4>

                <a href="/add-job" class="btn btn-success mt-3">
                    Add Job
                </a>

            </div>

        </div>

        <div class="col-md-3 mb-4">

            <div class="card shadow text-center p-4">

                <h4>Applications</h4>

                <a href="/my-applications" class="btn btn-warning mt-3">
                    My Applications
                </a>

            </div>

        </div>

        <div class="col-md-3 mb-4">

            <div class="card shadow text-center p-4">

                <h4>Profile</h4>

                <a href="/profile" class="btn btn-info mt-3">
                    My Profile
                </a>


            </div>

        </div>

    </div>

</div>

</body>
</html>